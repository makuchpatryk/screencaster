# What `screencaster setup` downloads. This file is embedded in the binary and
# is the only place these values live in Go; providers/piper/Dockerfile (Piper,
# voices) and the root Dockerfile (Playwright) repeat them as ARGs and
# pins_test.go fails when they differ (decisions 77, 82).
#
# To update without rebuilding, either:
#   - set any key below as an environment variable (it wins over this file), or
#   - run `setup --pins-file my-pins.env` (same format; wins over this file,
#     loses to the environment).
# A version or revision key needs its sha256 key(s) in the same place (Piper,
# Node.js, playwright-core, Chromium with its headless shell, ffmpeg). Every
# download is sha256-checked, and nothing is installed from an unchecked file.

# Piper release: <PIPER_URL_BASE><PIPER_VERSION>/piper_linux_x86_64.tar.gz
SCREENCASTER_PIPER_VERSION=2023.11.14-2
SCREENCASTER_PIPER_SHA256=a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992
SCREENCASTER_PIPER_URL_BASE=https://github.com/rhasspy/piper/releases/download/

# Voices: <VOICES_URL_BASE><VOICES_REV>/<path>
SCREENCASTER_VOICES_REV=c10ece1aade47bb51c153c893d14e5bf8e5b7117
SCREENCASTER_VOICES_URL_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/

# The built-in voices (BR-011), one file per line: name=path=sha256.
# Listing any here (or in a --pins-file) replaces the list from the layer below;
# the environment variable SCREENCASTER_VOICE_FILES (entries joined by ;) does too.
SCREENCASTER_VOICE_FILE=en_US-ryan-high.onnx=en/en_US/ryan/high/en_US-ryan-high.onnx=b3990d7606e183ec8dbfba70a4607074f162de1a0c412e0180d1ff60bb154eca
SCREENCASTER_VOICE_FILE=en_US-ryan-high.onnx.json=en/en_US/ryan/high/en_US-ryan-high.onnx.json=c6d3b98f08315cb4bebf0d49d50fc4ff491b503c64b940cd3d5ca28543b48011
SCREENCASTER_VOICE_FILE=pl_PL-darkman-medium.onnx=pl/pl_PL/darkman/medium/pl_PL-darkman-medium.onnx=db505438a5364e8e2e0242c4324130a873ed660dfbe8d9689cef428ffb1b645f
SCREENCASTER_VOICE_FILE=pl_PL-darkman-medium.onnx.json=pl/pl_PL/darkman/medium/pl_PL-darkman-medium.onnx.json=70f999f11fa8ad13d3ef779041ee93c9f38be5abdbacdfad42449712fe91c81b

# Playwright (decision 82): setup fetches these itself instead of calling
# playwright.Install. They are what playwright-go v0.6201.1 downloads: Node.js
# and the playwright-core npm package make the driver (<dir>/node and
# <dir>/package), Chromium, its headless shell and Playwright's ffmpeg (video
# recording) make the browsers dir. PLAYWRIGHT_GO_VERSION must equal go.mod's.
SCREENCASTER_PLAYWRIGHT_GO_VERSION=v0.6201.1

# Node.js: <NODE_URL_BASE>v<NODE_VERSION>/node-v<NODE_VERSION>-linux-x64.tar.gz
# (sha256 equals nodejs.org SHASUMS256.txt).
SCREENCASTER_NODE_VERSION=24.19.0
SCREENCASTER_NODE_URL_BASE=https://nodejs.org/dist/
SCREENCASTER_NODE_SHA256=f625d97cd707df4ff96254916fbc5ff014f09c09effe5a1e0ca8f6d41a8789d4

# playwright-core: <URL_BASE>playwright-core/-/playwright-core-<VERSION>.tgz
# (sha256 of the registry tarball; npm's own sha512 integrity was checked too).
SCREENCASTER_PLAYWRIGHT_CORE_VERSION=1.62.1
SCREENCASTER_PLAYWRIGHT_CORE_URL_BASE=https://registry.npmjs.org/
SCREENCASTER_PLAYWRIGHT_CORE_SHA256=954be1e183d0ddb9748fe0d2d08b0b66a9210c74dd75c397aeb70303b9f08a00

# Chromium (Chrome for Testing) and its headless shell, both from
# <CHROMIUM_URL_BASE>builds/cft/<CHROMIUM_VERSION>/linux64/<zip>; the revision
# only names the folders (chromium-<rev>, chromium_headless_shell-<rev>).
SCREENCASTER_CHROMIUM_REVISION=1234
SCREENCASTER_CHROMIUM_VERSION=151.0.7922.34
SCREENCASTER_CHROMIUM_URL_BASE=https://cdn.playwright.dev/
SCREENCASTER_CHROMIUM_SHA256=ae8736ac28bc69278551500f219fc749575648263c43ec5990749eff43b9fcf8
SCREENCASTER_HEADLESS_SHELL_SHA256=3cfc2bd00d1bafcf8a68dc74c9c92bb7150ddc8d26ade948a776316e1cec4f14

# Playwright's ffmpeg: <CHROMIUM_URL_BASE>builds/ffmpeg/<FFMPEG_REVISION>/ffmpeg-linux.zip
SCREENCASTER_FFMPEG_REVISION=1011
SCREENCASTER_FFMPEG_SHA256=ebc74fc5b94830176a3c2914ae96bd8bc7f6a91f4f33890230f84a172ee61ccc
