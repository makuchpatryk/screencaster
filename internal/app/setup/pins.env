# What `screencaster setup` downloads. This file is embedded in the binary and
# is the only place these values live in Go; providers/piper/Dockerfile repeats
# them as ARGs and pins_test.go fails when the two differ (decision 77).
#
# To update without rebuilding, either:
#   - set any key below as an environment variable (it wins over this file), or
#   - run `setup --pins-file my-pins.env` (same format; wins over this file,
#     loses to the environment).
# SCREENCASTER_PIPER_VERSION needs its SCREENCASTER_PIPER_SHA256 in the same
# place. Every download is sha256-checked.

# Piper release: <PIPER_URL_BASE><PIPER_VERSION>/piper_linux_x86_64.tar.gz
SCREENCASTER_PIPER_VERSION=2023.11.14-2
SCREENCASTER_PIPER_SHA256=a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992
SCREENCASTER_PIPER_URL_BASE=https://github.com/rhasspy/piper/releases/download/

# Voices: <VOICES_URL_BASE><VOICES_REV>/<path>
SCREENCASTER_VOICES_REV=c10ece1aade47bb51c153c893d14e5bf8e5b7117
SCREENCASTER_VOICES_URL_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/

# The built-in voices (BR-011), one file per line: name=path=sha256.
# Listing any here (or in a --pins-file) replaces the list from the layer below;
# the environment variable SCREENCASTER_VOICE_FILES (entries joined by ;) does too.
SCREENCASTER_VOICE_FILE=en_US-ryan-high.onnx=en/en_US/ryan/high/en_US-ryan-high.onnx=b3990d7606e183ec8dbfba70a4607074f162de1a0c412e0180d1ff60bb154eca
SCREENCASTER_VOICE_FILE=en_US-ryan-high.onnx.json=en/en_US/ryan/high/en_US-ryan-high.onnx.json=c6d3b98f08315cb4bebf0d49d50fc4ff491b503c64b940cd3d5ca28543b48011
SCREENCASTER_VOICE_FILE=pl_PL-darkman-medium.onnx=pl/pl_PL/darkman/medium/pl_PL-darkman-medium.onnx=db505438a5364e8e2e0242c4324130a873ed660dfbe8d9689cef428ffb1b645f
SCREENCASTER_VOICE_FILE=pl_PL-darkman-medium.onnx.json=pl/pl_PL/darkman/medium/pl_PL-darkman-medium.onnx.json=70f999f11fa8ad13d3ef779041ee93c9f38be5abdbacdfad42449712fe91c81b
